<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wbms.Mobile"
             x:Class="Wbms.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#0B6E99</Color>
            <Color x:Key="Danger">#C62828</Color>
            <Color x:Key="Muted">#6B7280</Color>
            <local:InverseBoolConverter x:Key="Not" />
            <local:NotNullConverter x:Key="HasValue" />

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="FontSize" Value="18" />
            </Style>
            <Style x:Key="Title" TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="Error" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Danger}" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Stroke" Value="#E5E7EB" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1F2937}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
