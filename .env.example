# AquaPure Water: every setting the project uses, with placeholder values.
# Never commit real values. See SETUP.md, section 4.
#
# The API (.NET Framework 4.8) reads these as ENVIRONMENT VARIABLES first, then from
# api/AquaPure.Api/App.config and api/AquaPure.Api/secrets.config (git-ignored).
# For local development the simplest way is: copy secrets.config.example to secrets.config
# and fill it in. On a server, set environment variables (or use deploy/iis/api.web.config).

# ---------------------------------------------------------------- API: public settings
# Where the API listens (ignored under IIS, which passes its own port).
API_URL=http://localhost:5080/
# Website addresses allowed to call the API, comma-separated, no trailing slash.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
# true when IIS / a load balancer is in front, so rate limits see the real client IP.
TRUST_PROXY=false

# Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Optional: the Supabase address browsers should use (a proxy on your own domain), if
# *.supabase.co is blocked by some ISPs. Used for product image links. SETUP.md 15.4.
SUPABASE_PUBLIC_URL=

# ---------------------------------------------------------------- API: SECRETS (server only)
# Only for older Supabase projects that sign tokens with the legacy JWT secret. New projects: leave empty.
SUPABASE_JWT_SECRET=
# Session pooler connection for the wbms_api database role (Supabase Dashboard -> Connect).
# The password is the one you set with: alter role wbms_api with password '...';
DB_CONNECTION=Host=aws-0-REGION.pooler.supabase.com;Port=5432;Database=postgres;Username=wbms_api.YOUR-PROJECT-REF;Password=YOUR-WBMS-API-PASSWORD;SSL Mode=Require

# Razorpay Dashboard -> Account & Settings -> API Keys (Test Mode keys start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Razorpay Dashboard -> Account & Settings -> Webhooks -> the secret you chose (required for live keys)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ---------------------------------------------------------------- Website (public, not secret)
# The website does not read environment variables. It loads web/public/config.json at start-up
# (git-ignored; copy web/public/config.example.json). These three values are public by design:
#   "apiBaseUrl":             "http://localhost:5080"                (your API address)
#   "supabaseUrl":            "https://YOUR-PROJECT-REF.supabase.co" (or your proxy address)
#   "supabasePublishableKey": "sb_publishable_..."                   (Project Settings -> API Keys)
#
# NOT USED ANYWHERE, AND MUST NEVER BE ADDED: the Supabase service_role / secret key.
