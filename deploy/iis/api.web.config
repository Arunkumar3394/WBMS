<?xml version="1.0" encoding="utf-8"?>
<!--
  AquaPure API on IIS. Copy this file as "web.config" into the API site folder, next to
  AquaPure.Api.exe (the contents of api\AquaPure.Api\bin\Release\net48\).
  Needs the IIS "HttpPlatformHandler" module (free download from Microsoft). See SETUP.md, section 15.

  Secrets: set them as environment variables below, OR put a secrets.config next to the exe
  (copied from secrets.config.example). Make sure that folder is not readable by the web
  (this web.config sends every request to the API, so the files are never served).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath=".\AquaPure.Api.exe"
                  startupTimeLimit="60"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\api.log"
                  forwardWindowsAuthToken="false">
      <environmentVariables>
        <!-- The site address(es) that may call the API, comma-separated, no trailing slash. -->
        <environmentVariable name="ALLOWED_ORIGINS" value="https://www.your-domain.in,https://your-domain.in" />
        <environmentVariable name="SUPABASE_URL" value="https://YOUR-PROJECT-REF.supabase.co" />
        <!-- Optional, see SETUP.md 15.4 (only if *.supabase.co is blocked for some customers). -->
        <environmentVariable name="SUPABASE_PUBLIC_URL" value="" />
        <!-- Leave the secrets out of this file if you use secrets.config instead:
        <environmentVariable name="DB_CONNECTION" value="Host=...;Username=wbms_api.YOUR-PROJECT-REF;Password=...;SSL Mode=Require" />
        <environmentVariable name="RAZORPAY_KEY_ID" value="rzp_live_..." />
        <environmentVariable name="RAZORPAY_KEY_SECRET" value="..." />
        <environmentVariable name="RAZORPAY_WEBHOOK_SECRET" value="..." />
        -->
      </environmentVariables>
    </httpPlatform>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
