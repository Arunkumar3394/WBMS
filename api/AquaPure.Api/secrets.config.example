<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to secrets.config (same folder) and fill in your values.
  secrets.config is git-ignored. On a server, use environment variables instead.
-->
<appSettings>
  <!-- Supabase Dashboard → Project Settings → API → Project URL -->
  <add key="SUPABASE_URL" value="https://tjkkjlfyyumygqxcudhs.supabase.co" />

  <!-- Only for older projects that still sign tokens with the legacy JWT secret (HS256).
       New projects use signing keys and need nothing here. -->
  <add key="SUPABASE_JWT_SECRET" value="" />

  <!-- Supabase Dashboard → Connect → Session pooler. User is wbms_api.tjkkjlfyyumygqxcudhs,
       password is the one you set with: alter role wbms_api with password '...'; -->
  <add key="DB_CONNECTION" value="Host=aws-0-ap-northeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=wbms_api.tjkkjlfyyumygqxcudhs;Password=YOUR-WBMS-API-PASSWORD;SSL Mode=Require" />

  <!-- Razorpay Dashboard (Test Mode) → Account &amp; Settings → API Keys -->
  <add key="RAZORPAY_KEY_ID" value="rzp_test_xxxxxxxxxxxxxx" />
  <add key="RAZORPAY_KEY_SECRET" value="your-test-key-secret" />
  <!-- Razorpay Dashboard → Webhooks → the secret you typed when creating the webhook -->
  <add key="RAZORPAY_WEBHOOK_SECRET" value="your-webhook-secret" />
</appSettings>
