<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework" requirePermission="false" />
  </configSections>
  <entityFramework>
    <providers>
      <provider invariantName="Effort.Provider" type="Effort.Provider.EffortProviderServices, Effort" />
    </providers>
  </entityFramework>
  <system.data>
    <DbProviderFactories>
      <remove invariant="Effort.Provider" />
      <add name="Effort.Provider" description="Effort.Provider" invariant="Effort.Provider" type="Effort.Provider.EffortProviderFactory, Effort" />
    </DbProviderFactories>
  </system.data>
</configuration>
