<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Settings are read from environment variables first, then from here.
    Secrets go in secrets.config next to this file (git-ignored; copy secrets.config.example)
    or in environment variables on the server. Never put real secrets in this file.
  -->
  <appSettings file="secrets.config">
    <!-- Address the API listens on. In IIS (HttpPlatformHandler) the port comes from HTTP_PLATFORM_PORT. -->
    <add key="API_URL" value="http://localhost:5080/" />
    <!-- Browser origins allowed to call the API (comma-separated). -->
    <add key="ALLOWED_ORIGINS" value="http://localhost:4200" />
    <!-- Set to true when IIS or a load balancer sits in front, so rate limits use the real client IP. -->
    <add key="TRUST_PROXY" value="false" />

    <add key="SUPABASE_URL" value="" />
    <add key="SUPABASE_JWT_SECRET" value="" />
    <add key="DB_CONNECTION" value="" />

    <add key="RAZORPAY_KEY_ID" value="" />
    <add key="RAZORPAY_KEY_SECRET" value="" />
    <add key="RAZORPAY_WEBHOOK_SECRET" value="" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
