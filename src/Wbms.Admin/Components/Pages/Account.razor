@page "/account"
@using System.Security.Claims
@inject AuthService Auth

<PageTitle>Account</PageTitle>
<h3>Change password</h3>

@if (message is not null) { <div class="alert alert-@(ok ? "success" : "danger")">@message</div> }

<EditForm Model="Input" FormName="password" OnValidSubmit="Save" method="post" style="max-width: 360px">
    <div class="mb-3"><label class="form-label">Current password</label><InputText type="password" class="form-control" @bind-Value="Input.Current" /></div>
    <div class="mb-3"><label class="form-label">New password (8+ characters)</label><InputText type="password" class="form-control" @bind-Value="Input.New" /></div>
    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>

@code {
    [CascadingParameter] HttpContext HttpContext { get; set; } = null!;
    [SupplyParameterFromForm] Model Input { get; set; } = new();
    string? message;
    bool ok;

    class Model { public string Current { get; set; } = ""; public string New { get; set; } = ""; }

    async Task Save()
    {
        try
        {
            var userId = int.Parse(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier)!);
            await using var db = await DbFactory.CreateDbContextAsync();
            var phone = (await db.Users.FindAsync(userId))!.Phone;
            await Auth.VerifyPasswordAsync(phone, Input.Current);
            await Auth.SetPasswordAsync(userId, Input.New);
            (ok, message) = (true, "Password changed.");
        }
        catch (WorkflowException ex) { (ok, message) = (false, ex.Message == "Wrong phone number or password." ? "Current password is wrong." : ex.Message); }
        Input = new();
    }
}
